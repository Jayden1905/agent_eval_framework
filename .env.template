# Copy to .env and fill in. .env is gitignored — DO NOT commit.
DAYTONA_API_KEY=
DAYTONA_TARGET=us

# Nosana-hosted OpenAI-compatible endpoint used by both the demo agents
# and the DeepEval judge (agents + judge on the same model — see README).
# BASE_URL should end in /v1/ (OpenAI SDK convention).
# NOSANA_API_KEY: leave blank if the endpoint has no auth — server.py
# will fill OPENAI_API_KEY with a placeholder string (the openai SDK
# rejects an empty api_key, so it needs *some* value).
NOSANA_BASE_URL=
NOSANA_API_KEY=
NOSANA_MODEL=llama-3.1-70b-instruct

# GitHub PAT used by `make push` / `make pull`. Fine-grained, scoped to
# this repo only. Get one at https://github.com/settings/tokens?type=beta
# and paste the value here.
GITHUB_TOKEN=
